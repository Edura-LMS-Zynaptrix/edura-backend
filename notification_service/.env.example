DATABASE_URL=postgresql://neondb_owner:<password>@<your-neon-endpoint>/neondb?sslmode=require
SECRET_KEY=your_secret_key_here
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq

# SMTP Configuration (Optional for real email dispatch; defaults to local/mock SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@edura.com
SMTP_USE_TLS=true
