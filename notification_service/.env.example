DATABASE_URL=postgresql://neondb_owner:<password>@<your-neon-endpoint>/neondb?sslmode=require
SECRET_KEY=your_secret_key_here
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq

# Email is sent with Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
# A sender on a domain verified in Resend; onboarding@resend.dev works while testing
# (it can only deliver to the email address of your Resend account).
RESEND_FROM_EMAIL=Edura <noreply@eduralms.com>
